# Dockerfile.bff
FROM golang:1.23-alpine AS builder

WORKDIR /build

COPY go.work go.work.sum ./
COPY pkg/go.mod pkg/go.sum ./pkg/
COPY services/bff/go.mod services/bff/go.sum ./services/bff/

RUN go work sync
RUN cd services/bff && go mod download

COPY pkg/ ./pkg/
COPY services/bff/ ./services/bff/

RUN cd services/bff && CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /build/bff ./cmd/bff

FROM alpine:3.18

RUN apk --no-cache add ca-certificates && \
    adduser -D -u 10001 appuser

WORKDIR /app

COPY --from=builder /build/bff .

USER appuser

EXPOSE 8000 9095

CMD ["./bff"]
