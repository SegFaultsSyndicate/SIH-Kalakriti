# Dockerfile.channel-svc
FROM golang:1.25-alpine AS builder

WORKDIR /build

COPY pkg/go.mod pkg/go.sum ./pkg/
COPY services/channel-svc/go.mod services/channel-svc/go.sum ./services/channel-svc/

RUN cd services/channel-svc && go mod download

COPY pkg/ ./pkg/
COPY services/channel-svc/ ./services/channel-svc/

RUN cd services/channel-svc && CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /build/channel-svc ./cmd/channel-svc

FROM alpine:3.18

RUN apk --no-cache add ca-certificates && \
    adduser -D -u 10001 appuser

WORKDIR /app

COPY --from=builder /build/channel-svc .

USER appuser

EXPOSE 8084 9096

CMD ["./channel-svc"]
