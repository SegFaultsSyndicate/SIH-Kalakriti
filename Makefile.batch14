# Makefile additions for BATCH 14

# Generate a development Ed25519 keypair for provenance signing
.PHONY: keygen
keygen:
	@echo "Generating Ed25519 keypair for provenance signing..."
	@go run -tags tools scripts/keygen.go

# Generate printable provenance tags
.PHONY: tags
tags:
	@if [ -z "$(CODES)" ]; then \
		echo "Usage: make tags CODES=CODE1,CODE2,CODE3"; \
		exit 1; \
	fi
	@go run scripts/make-tags.go -codes $(CODES) -base-url $(BASE_URL) -output $(OUTPUT)
	@echo "Tags generated: $(OUTPUT)"

# Example:
# make tags CODES=ABCD123456,EFGH789012 BASE_URL=https://kalakriti.example.com OUTPUT=tags.html
