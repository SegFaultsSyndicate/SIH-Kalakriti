{
  "name": "kalakriti-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:artisan": "pnpm -F artisan dev",
    "dev:buyer": "pnpm -F buyer dev",
    "dev:admin": "pnpm -F admin dev",
    "build": "pnpm -r build",
    "preview": "pnpm -r preview",
    "check": "svelte-check --tsconfig ./tsconfig.base.json",
