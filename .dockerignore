# .dockerignore
# There was no .dockerignore before this — every `docker build`/`docker
# compose build` sent the whole repo as context, including every service's
# node_modules/.venv/build output. Mirrors .gitignore's excludes, except it
# deliberately does NOT exclude the generated pb/ and repo/db directories
# .gitignore keeps out of git: the Dockerfiles COPY those, they just aren't
# committed (see `make proto` / `make sqlc`, run before any Docker build).

.git/

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# Go build output and test artifacts
bin/
**/bin/
*.exe
*.dll
*.so
*.dylib
*.test
*.out
coverage.out

# Python caches, environments, and packaging output
__pycache__/
*.py[cod]
*.pyo
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
*.egg-info/
htmlcov/
.coverage

# JavaScript tooling: every workspace's own node_modules, build output, and
# per-app SvelteKit caches — Dockerfile.web installs and builds fresh inside
# the image, it never reads these from the host.
node_modules/
.svelte-kit/
dev-dist/
build/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
size-report.json

# Logs, temporary files, and generated demo artifacts
*.log
*.tmp
*.temp
*.bak
qr-sheet.pdf
qr_*.png

# Local database and export files
*.db
*.sqlite
*.sqlite3
exports/

# Environment files and local secrets — never belong in an image layer
.env
.env.*
!.env.example
deploy/k8s/secret.yaml
*.local
*.secret
*.secret.yaml
*.pem
*.key
*.crt
*.p12
*.pfx
