# Dockerfile.collab-svc
FROM golang:1.25-alpine AS builder

WORKDIR /build

COPY pkg/go.mod pkg/go.sum ./pkg/
COPY services/collab-svc/go.mod services/collab-svc/go.sum ./services/collab-svc/

RUN cd services/collab-svc && go mod download

COPY pkg/ ./pkg/
COPY services/collab-svc/ ./services/collab-svc/

RUN cd services/collab-svc && CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /build/collab-svc ./cmd/collab-svc

FROM alpine:3.18

RUN apk --no-cache add ca-certificates && \
    adduser -D -u 10001 appuser

WORKDIR /app

COPY --from=builder /build/collab-svc .

USER appuser

EXPOSE 8083 50053

CMD ["./collab-svc"]
