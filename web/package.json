{
  "name": "kalakriti-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev:artisan": "pnpm -F @kalakriti/artisan dev",
    "dev:buyer": "pnpm -F @kalakriti/buyer dev",
    "dev:admin": "pnpm -F @kalakriti/admin dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "build:artisan": "pnpm -F @kalakriti/artisan build",
    "build:buyer": "pnpm -F @kalakriti/buyer build",
    "build:admin": "pnpm -F @kalakriti/admin build",
    "preview:artisan": "pnpm -F @kalakriti/artisan preview",
    "preview:buyer": "pnpm -F @kalakriti/buyer preview",
    "preview:admin": "pnpm -F @kalakriti/admin preview",
    "check": "node scripts/check-brand-tokens.mjs && node scripts/check-contrast.mjs && node scripts/validate-all.mjs && pnpm -r --filter \"./apps/*\" check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --filter \"!@kalakriti/e2e\" test",
    "e2e": "pnpm -F @kalakriti/e2e test",
    "size": "SIZE_BUDGET_ENFORCE=1 pnpm -r --filter \"./apps/*\" build",
    "assets:icons": "node scripts/gen-maskable-icons.mjs",
    "assets:validate": "node scripts/validate-all.mjs",
    "assets:check-provenance": "node scripts/check-provenance-assets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "eslint-plugin-svelte": "^2.46.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^3.2.0",
    "sharp": "^0.33.5",
    "svelte": "^5.1.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "msw",
      "core-js"
    ]
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ]
}
