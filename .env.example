# ==============================================================================
# KALAKRITI ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Adjust values as needed for your target environment (local dev vs prod).
# 3. DO NOT commit '.env' to git — it is ignored in .gitignore.
# ==============================================================================

# ==============================================================================
# 1. APPLICATION RUNTIME & BASE URLS
# ==============================================================================
# Deployment environment: "development", "staging", "production" (pkg/config reads APP_ENV)
APP_ENV=development

# Base URL for the public REST gateway / BFF
# REQUIRED by services/bff (mustEnv("BASE_URL")).
# Used for QR code verification URLs (/v/{code}), digital literacy certificates (/verify/certificate/{code}),
# and CORS origin verification.
BASE_URL=http://localhost:8000

# BFF HTTP Listener port and address
BFF_HTTP_PORT=8000
BFF_ADDR=:8000

# Public web frontend port (NGINX serves buyer at /, artisan at :8081, admin at :8082)
WEB_PORT=80
WEB_DIST=./web/dist

# Graceful shutdown deadline for in-flight requests and background workers
SHUTDOWN_TIMEOUT=15s


# ==============================================================================
# 2. DATABASE CONFIGURATION (PostgreSQL + pgvector)
# ==============================================================================
# PostgreSQL 18 instance with pgvector extension enabled.
# Note: In docker-compose, the host port is mapped to 15432 to avoid Windows port collisions,
# while the internal container port remains 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=kalakriti
POSTGRES_USER=kalakriti
POSTGRES_PASSWORD=kalakriti

# Full connection string for Go services & Goose migrations
POSTGRES_DSN=postgres://kalakriti:kalakriti@localhost:15432/kalakriti?sslmode=disable

# pgxpool connection pool settings (per microservice)
POSTGRES_MAX_CONNS=25
POSTGRES_MIN_CONNS=5
POSTGRES_MAX_CONN_LIFETIME=1h
POSTGRES_MAX_CONN_IDLE_TIME=15m


# ==============================================================================
# 3. CACHE & IN-MEMORY STORE (Redis)
# ==============================================================================
# Redis 7 Alpine instance used for token blacklisting, rate limiting, and session caching.
# Note: In docker-compose, host port is mapped to 16379 to avoid host port collisions.
REDIS_ADDR=localhost:16379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=10


# ==============================================================================
# 4. EVENT STREAMING & MESSAGE BROKER (Apache Kafka - KRaft Mode)
# ==============================================================================
# Event bus for domain events (listing.published, order.created, lot.offered, etc.).
# Comma-separated list of bootstrap brokers (required by pkg/config).
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP_PREFIX=kalakriti
KAFKA_CLUSTER_ID=ja3_hAH_QZy-U4RiCUtuQQ


# ==============================================================================
# 5. OBJECT STORAGE (MinIO / S3-Compatible)
# ==============================================================================
# Used for artisan product images, process videos, voice consent audio, and PDF statements.
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD initialize the MinIO server container.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# S3 client settings consumed by Go services and ml-svc
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=kalakriti
S3_REGION=ap-south-1
S3_USE_SSL=false

# Public URL handed to browser clients for presigned uploads/downloads
S3_PUBLIC_URL=http://localhost:9000

# Media limits & lifetimes
MEDIA_MAX_IMAGE_BYTES=15728640
MEDIA_MAX_VIDEO_BYTES=104857600
MEDIA_UPLOAD_URL_TTL=15m
MEDIA_DOWNLOAD_URL_TTL=1h
MEDIA_PENDING_TTL=24h
MEDIA_REAPER_INTERVAL=15m
MEDIA_REAPER_BATCH_SIZE=200


# ==============================================================================
# 6. AUTHENTICATION & SECURITY
# ==============================================================================
# JWT signing secret (>= 32 bytes). In production, generate with: openssl rand -base64 32
JWT_SECRET=dev-secret-change-in-prod-32bytes-minimum
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
JWT_ISSUER=kalakriti

# HMAC key for government finance corporation loan references (NSFDC/NBCFDC/NSKFDC/NDFDC).
# Only the last 4 characters and this HMAC are persisted. Must be >= 32 bytes in production.
FINANCE_REF_SALT=

# Ed25519 Public Key for provenance record signature verification (hex encoded)
PROVENANCE_PUBLIC_KEY=

# Local development OTP bypass (MUST BE FALSE IN PRODUCTION)
# Allows testing artisan login without real SMS gateway integration.
AUTH_DEV_OTP_ENABLED=true
AUTH_DEV_OTP_CODE=000000

# SMS Provider integration (when AUTH_DEV_OTP_ENABLED=false)
# Supported: "mock", "msg91", "twilio"
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=KALAKR

# OTP rate limiting (raised for local development/seeding; default in prod is 5 requests per 10m)
OTP_RATE_LIMIT=10000
OTP_RATE_LIMIT_WINDOW=10m

# CORS Allowed Origins (comma-separated).
# Required to prevent CSRF failures when accessing the BFF from web apps on different ports.
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:8081,http://localhost:8082,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:4173,http://localhost:4174,http://localhost:4175

# Idempotency header and storage window (deduplicates retried requests from flaky rural networks)
REQUEST_ID_HEADER=X-Request-ID
IDEMPOTENCY_TTL=24h


# ==============================================================================
# 7. MICROSERVICES INTERNAL ADDRESSES (gRPC & HTTP)
# ==============================================================================
# Addresses used by the BFF and internal services to communicate over gRPC.

# core-svc: Identity, artisan profiles, catalog, provenance, badges, assisted mode
CORE_SVC_ADDR=localhost:50051
CORE_SVC_HTTP_PORT=8081

# search-svc: pgvector similarity search, multimodal search, filtering
SEARCH_SVC_ADDR=localhost:50052
SEARCH_SVC_HTTP_PORT=8082

# collab-svc: Collective fulfilment, lot allocation, pooled orders, SSE event stream
COLLAB_SVC_ADDR=localhost:50053
COLLAB_SVC_HTTP_PORT=8083

# channel-svc: Outbound channels (ONDC, GeM, IndiaHandmade, WhatsApp)
CHANNEL_SVC_ADDR=http://localhost:8084
CHANNEL_SVC_GRPC_ADDR=localhost:9096
CHANNEL_SVC_HTTP_PORT=8084

# insight-svc: Ministry analytics (MoSJE), median income, PDF statements with QR
INSIGHT_SVC_ADDR=localhost:8085

# ml-svc: Python AI service (VLM cataloging, image lighting, Indic translation, embeddings)
ML_SVC_ADDR=localhost:50055
ML_SVC_HTTP_PORT=8085


# ==============================================================================
# 8. MACHINE LEARNING SERVICE (ml-svc)
# ==============================================================================
# Set ML_SVC_MOCK_MODE=true for instant local startup without downloading model checkpoints.
# When true, all vision, translation, and embedding calls return deterministic mock payloads.
ML_SVC_MOCK_MODE=true

ML_SVC_GRPC_PORT=50055
ML_SVC_METRICS_PORT=9095
ML_SVC_MODEL_CACHE_DIR=/root/.cache/huggingface

# VLM Backend: "transformers" (in-process PyTorch) or "llamacpp" (HTTP client to llama-server)
ML_SVC_VLM_BACKEND=transformers
ML_SVC_VLM_LLAMACPP_URL=http://localhost:8090

# Zero-DCE++ low-light checkpoint path (bind-mounted in Docker or local path)
ML_SVC_IMAGE_LIGHTING_MODEL=/models/zero_dce_pp/Epoch99.pth

# Hugging Face token (required only for downloading gated IndicTrans2 models)
ML_SVC_TRANSLATION_HF_TOKEN=
HF_TOKEN=

# Supported catalog translation languages (20 scheduled Indic languages + English)
PIPELINE_BUYER_LANGUAGES=ASSAMESE,BENGALI,BODO,DOGRI,GUJARATI,HINDI,KANNADA,KASHMIRI,KONKANI,MAITHILI,MALAYALAM,MARATHI,NEPALI,ODIA,PUNJABI,SANSKRIT,SINDHI,TAMIL,TELUGU,URDU,ENGLISH
PIPELINE_STEP_TIMEOUT=90s


# ==============================================================================
# 9. OBSERVABILITY & TELEMETRY
# ==============================================================================
# OpenTelemetry Tracing (Jaeger)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=kalakriti
OTEL_TRACE_SAMPLER=always_on
OTEL_TRACE_RATIO=1.0

# Prometheus Metrics
PROMETHEUS_PORT=9090
METRICS_ENABLED=true

# Structured JSON Logging
LOG_LEVEL=info
LOG_FORMAT=json


# ==============================================================================
# 10. EXTERNAL INTEGRATIONS & GOVERNMENT PLATFORMS
# ==============================================================================
# ONDC (Open Network for Digital Commerce) Beckn Protocol Gateway
ONDC_SUBSCRIBER_ID=
ONDC_SUBSCRIBER_URL=
ONDC_SIGNING_KEY=
ONDC_ENCRYPTION_KEY=
ONDC_DRY_RUN=true

# WhatsApp Business API (Automated notifications and voice clips in local dialect)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DRY_RUN=true

# India Post API (SpeedPost pickup scheduling and tracking)
INDIAPOST_API_KEY=
INDIAPOST_API_URL=https://api.indiapost.gov.in

# IndiaHandmade.in & GeM (Government e-Marketplace) CSV/JSON export directory
INDIAHANDMADE_API_KEY=
INDIAHANDMADE_EXPORT_DIR=/tmp/exports


# ==============================================================================
# 11. BUSINESS RULES & DOMAIN CONSTANTS
# ==============================================================================
# Platform fee in basis points (250 = 2.5%)
PLATFORM_FEE_BPS=250

# Minimum item quantity to qualify as a collective pooled order
BULK_ORDER_MIN_QUANTITY=50

# Quality Check (QC) rework window for rejected artisan lots
QC_REWORK_WINDOW=72h

# Voting window for artisans on bulk order specification amendments
AMENDMENT_VOTING_WINDOW=48h


# ==============================================================================
# 12. FRONTEND WEB APPS (Vite / SvelteKit Client Environment)
# ==============================================================================
# Base URL for API calls from browser apps (defaults to /api/v1 when proxied via NGINX)
VITE_API_BASE=/api/v1

# Frontend local mock fallback (1 = enabled for offline frontend work without backend)
VITE_USE_MOCKS=0

# Frontend demo mode (1 = fixed random seeds for deterministic conference presentations)
PUBLIC_DEMO_MODE=0

# Optional Sentry DSN for frontend crash reporting
PUBLIC_SENTRY_DSN=
