# Kalakriti Environment Configuration Template
# Copy this file to .env and adjust values for your environment
# DO NOT commit .env to git (it's in .gitignore)

# ============================================================================
# Environment
# ============================================================================
# pkg/config reads APP_ENV (envDefault "local"), not ENV.
APP_ENV=development

# ============================================================================
# PostgreSQL Database
# ============================================================================
POSTGRES_USER=kalakriti
POSTGRES_PASSWORD=kalakriti
POSTGRES_DB=kalakriti
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_DSN=postgres://kalakriti:kalakriti@localhost:5432/kalakriti?sslmode=disable

# Connection pool settings (per service)
POSTGRES_MAX_CONNS=25
POSTGRES_MIN_CONNS=5
POSTGRES_MAX_CONN_LIFETIME=1h
POSTGRES_MAX_CONN_IDLE_TIME=15m

# ============================================================================
# Redis
# ============================================================================
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=10

# ============================================================================
# Kafka
# ============================================================================
# pkg/config requires KAFKA_BROKERS (comma-separated), not
# KAFKA_BOOTSTRAP_SERVERS -- a service started with the wrong name here
# refuses to start (it's a required field with no default).
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP_PREFIX=kalakriti

# ============================================================================
# MinIO (S3-compatible object storage)
# ============================================================================
# MINIO_ROOT_USER/PASSWORD below only bootstrap the MinIO *server* container
# itself (docker-compose's `minio` service reads these directly). Every Go
# service instead reads the S3_* names via pkg/config -- MINIO_ENDPOINT/
# MINIO_BUCKET/etc. are silently ignored by the services, not just renamed.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Must match the bucket docker-compose's minio-init service creates.
S3_BUCKET=kalakriti
S3_USE_SSL=false
S3_REGION=ap-south-1

# Media settings
MEDIA_PENDING_TTL=1h
MEDIA_MAX_SIZE_MB=10

# ============================================================================
# Authentication & Authorization
# ============================================================================
# SECURITY: Generate a strong random secret for production
# Example: openssl rand -base64 32
JWT_SECRET=dev-secret-change-in-production-use-openssl-rand-base64-32

# JWT token expiration. pkg/config reads JWT_ACCESS_TTL/JWT_REFRESH_TTL (not
# the _TOKEN_ infix); JWT_ISSUER defaults to "kalakriti" if unset.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
JWT_ISSUER=kalakriti

# Dev-only OTP bypass (MUST be false in production)
AUTH_DEV_OTP_ENABLED=true
AUTH_DEV_OTP_CODE=000000

# SMS provider (optional, not needed if DEV_OTP_ENABLED=true)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=KALAKR

# ============================================================================
# Services (gRPC ports)
# ============================================================================
# These *_SVC_ADDR vars are what OTHER services dial to reach this one (bff,
# search-svc, etc. as gRPC clients) -- they match docker-compose.yml's
# internal service:port values. A service binding its OWN listener instead
# reads its own var (e.g. core-svc reads CORE_SVC_GRPC_ADDR/CORE_SVC_HTTP_ADDR,
# defaulting to :50051/:8081 -- see each service's cmd/*/main.go for its own
# flag names before assuming *_HTTP_PORT below does anything).
CORE_SVC_ADDR=localhost:50051
CORE_SVC_HTTP_PORT=8081

SEARCH_SVC_ADDR=localhost:50052
SEARCH_SVC_HTTP_PORT=8082

COLLAB_SVC_ADDR=localhost:50053
COLLAB_SVC_HTTP_PORT=8083

# CHANNEL_SVC_ADDR is channel-svc's HTTP address (bff's export/webhook
# bridge reads it as such), unlike every other *_SVC_ADDR above which is
# a gRPC address — channel-svc's own gRPC address is CHANNEL_SVC_GRPC_ADDR.
CHANNEL_SVC_ADDR=http://localhost:8084
CHANNEL_SVC_GRPC_ADDR=localhost:9096
CHANNEL_SVC_HTTP_PORT=8084

# insight-svc has a single gRPC-only listener (GRPC_ADDR, default :8085) --
# there is no separate HTTP port to set.
INSIGHT_SVC_ADDR=localhost:8085

ML_SVC_ADDR=localhost:50055
ML_SVC_HTTP_PORT=8085

# ML Service mock mode (true = no model weights needed, <2s startup)
ML_SVC_MOCK_MODE=true

# BFF (REST API)
BFF_HTTP_PORT=8000
BFF_ADDR=localhost:8000

# ============================================================================
# Rate Limiting (BFF)
# ============================================================================
# Global rate limit (requests per minute per IP)
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# Per-endpoint overrides (comma-separated: endpoint:rps:burst)
# Example: /api/v1/auth/otp:5:10,/api/v1/search:50:100
RATE_LIMIT_ENDPOINTS=

# ============================================================================
# Observability
# ============================================================================
# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=kalakriti
OTEL_TRACE_SAMPLER=always_on
OTEL_TRACE_RATIO=1.0

# Prometheus
PROMETHEUS_PORT=9090
METRICS_ENABLED=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================================================
# External Integrations
# ============================================================================
# ONDC
ONDC_SUBSCRIBER_ID=
ONDC_SUBSCRIBER_URL=
ONDC_SIGNING_KEY=
ONDC_ENCRYPTION_KEY=
ONDC_DRY_RUN=true

# WhatsApp Business API
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DRY_RUN=true

# India Post API
INDIAPOST_API_KEY=
INDIAPOST_API_URL=https://api.indiapost.gov.in

# IndiaHandmade.in export
INDIAHANDMADE_API_KEY=
INDIAHANDMADE_EXPORT_DIR=/tmp/exports

# ============================================================================
# Feature Flags
# ============================================================================
FEATURE_VECTOR_SEARCH=true
FEATURE_AI_CATALOGING=true
FEATURE_BULK_ORDERS=true
FEATURE_INCOME_STATEMENTS=true
FEATURE_PROVENANCE_QR=true

# ============================================================================
# Security
# ============================================================================
# CORS allowed origins (comma-separated). Port is part of an origin, so this
# needs every port a browser might actually load a frontend from: the NGINX
# web container's three virtual hosts (buyer :80, artisan :8081, admin :8082)
# AND the three Vite dev-server ports from `pnpm dev:*` (artisan :5173, buyer
# :5174, admin :5175) -- see web/FRONTEND.md. Without the NGINX ports here,
# pkg/httpx's CSRFProtection middleware 403s every mutating request (login,
# registration, order creation, ...) from any of the three real web apps,
# since it only ever trusts BASE_URL's own origin otherwise (confirmed live).
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:8081,http://localhost:8082,http://localhost:5173,http://localhost:5174,http://localhost:5175

# Request ID header name
REQUEST_ID_HEADER=X-Request-ID

# Idempotency
IDEMPOTENCY_TTL=24h

# ============================================================================
# Business Logic
# ============================================================================
# Platform fee (basis points, 250 = 2.5%)
PLATFORM_FEE_BPS=250

# Bulk order minimum
BULK_ORDER_MIN_QUANTITY=50

# QC failure rework window
QC_REWORK_WINDOW=72h

# Order amendment voting window
AMENDMENT_VOTING_WINDOW=48h
