# Dockerfile.search-svc
FROM golang:1.25-alpine AS builder

WORKDIR /build

COPY pkg/go.mod pkg/go.sum ./pkg/
COPY services/search-svc/go.mod services/search-svc/go.sum ./services/search-svc/

RUN cd services/search-svc && go mod download

COPY pkg/ ./pkg/
COPY services/search-svc/ ./services/search-svc/

RUN cd services/search-svc && CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /build/search-svc ./cmd/search-svc

FROM alpine:3.18

RUN apk --no-cache add ca-certificates && \
    adduser -D -u 10001 appuser

WORKDIR /app

COPY --from=builder /build/search-svc .

USER appuser

EXPOSE 8082 50052

CMD ["./search-svc"]
