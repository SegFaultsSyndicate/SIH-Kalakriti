    "e2e": "playwright test",
    "size": "pnpm -r size"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "@vite-pwa/sveltekit": "^0.4.0",
    "svelte": "^5.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "svelte": "^5.0.0"
    }
  }
