# Hoist nothing implicitly: each app must declare what it imports, so the
# artisan build cannot accidentally resolve a package only admin depends on.
shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true
link-workspace-packages=true
prefer-workspace-packages=true
resolution-mode=highest
engine-strict=false

# The Docker build fetches a large dependency graph from npm and can hit transient
# network resets / slow registry responses. Retry settings keep the build from
# failing on a single flaky tarball fetch while still keeping the install strict.
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=600000
network-timeout=600000
