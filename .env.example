# Kalakriti Environment Configuration Template
# Copy this file to .env and adjust values for your environment
# DO NOT commit .env to git (it's in .gitignore)

# ============================================================================
# Environment
# ============================================================================
ENV=development

# ============================================================================
# PostgreSQL Database
# ============================================================================
POSTGRES_USER=kalakriti
POSTGRES_PASSWORD=kalakriti
POSTGRES_DB=kalakriti
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_DSN=postgres://kalakriti:kalakriti@localhost:5432/kalakriti?sslmode=disable

# Connection pool settings (per service)
POSTGRES_MAX_CONNS=25
POSTGRES_MIN_CONNS=5
POSTGRES_MAX_CONN_LIFETIME=1h
POSTGRES_MAX_CONN_IDLE_TIME=15m

# ============================================================================
# Redis
# ============================================================================
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=10

# ============================================================================
# Kafka
# ============================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_PREFIX=kalakriti

# ============================================================================
# MinIO (S3-compatible object storage)
# ============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=kalakriti-media
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

# Media settings
MEDIA_PENDING_TTL=1h
MEDIA_MAX_SIZE_MB=10

# ============================================================================
# Authentication & Authorization
# ============================================================================
# SECURITY: Generate a strong random secret for production
# Example: openssl rand -base64 32
JWT_SECRET=dev-secret-change-in-production-use-openssl-rand-base64-32

# JWT token expiration
JWT_ACCESS_TOKEN_TTL=24h
JWT_REFRESH_TOKEN_TTL=720h

# Dev-only OTP bypass (MUST be false in production)
AUTH_DEV_OTP_ENABLED=true
AUTH_DEV_OTP_CODE=000000

# SMS provider (optional, not needed if DEV_OTP_ENABLED=true)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=KALAKR

# ============================================================================
# Services (gRPC ports)
# ============================================================================
CORE_SVC_ADDR=localhost:50051
CORE_SVC_HTTP_PORT=8081

SEARCH_SVC_ADDR=localhost:50052
SEARCH_SVC_HTTP_PORT=8082

COLLAB_SVC_ADDR=localhost:50053
COLLAB_SVC_HTTP_PORT=8083

CHANNEL_SVC_ADDR=localhost:50057
CHANNEL_SVC_HTTP_PORT=8087

INSIGHT_SVC_ADDR=localhost:8085
INSIGHT_SVC_HTTP_PORT=8086

ML_SVC_ADDR=localhost:50055
ML_SVC_HTTP_PORT=8085

# ML Service mock mode (true = no model weights needed, <2s startup)
ML_SVC_MOCK_MODE=true

# BFF (REST API)
BFF_HTTP_PORT=8000
BFF_ADDR=localhost:8000

# ============================================================================
# Rate Limiting (BFF)
# ============================================================================
# Global rate limit (requests per minute per IP)
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# Per-endpoint overrides (comma-separated: endpoint:rps:burst)
# Example: /api/v1/auth/otp:5:10,/api/v1/search:50:100
RATE_LIMIT_ENDPOINTS=

# ============================================================================
# Observability
# ============================================================================
# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=kalakriti
OTEL_TRACE_SAMPLER=always_on
OTEL_TRACE_RATIO=1.0

# Prometheus
PROMETHEUS_PORT=9090
METRICS_ENABLED=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================================================
# External Integrations
# ============================================================================
# ONDC
ONDC_SUBSCRIBER_ID=
ONDC_SUBSCRIBER_URL=
ONDC_SIGNING_KEY=
ONDC_ENCRYPTION_KEY=
ONDC_DRY_RUN=true

# WhatsApp Business API
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DRY_RUN=true

# India Post API
INDIAPOST_API_KEY=
INDIAPOST_API_URL=https://api.indiapost.gov.in

# IndiaHandmade.in export
INDIAHANDMADE_API_KEY=
INDIAHANDMADE_EXPORT_DIR=/tmp/exports

# ============================================================================
# Feature Flags
# ============================================================================
FEATURE_VECTOR_SEARCH=true
FEATURE_AI_CATALOGING=true
FEATURE_BULK_ORDERS=true
FEATURE_INCOME_STATEMENTS=true
FEATURE_PROVENANCE_QR=true

# ============================================================================
# Security
# ============================================================================
# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Request ID header name
REQUEST_ID_HEADER=X-Request-ID

# Idempotency
IDEMPOTENCY_TTL=24h

# ============================================================================
# Business Logic
# ============================================================================
# Platform fee (basis points, 250 = 2.5%)
PLATFORM_FEE_BPS=250

# Bulk order minimum
BULK_ORDER_MIN_QUANTITY=50

# QC failure rework window
QC_REWORK_WINDOW=72h

# Order amendment voting window
AMENDMENT_VOTING_WINDOW=48h
